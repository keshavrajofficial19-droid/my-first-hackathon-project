    function searchFoodDatabase(q){
      q=q.toLowerCase().trim();
      // 1. Direct name or id contains
      for(const [k, v] of Object.entries(foodDB)) {
        if(v.name.toLowerCase() === q || k.toLowerCase() === q) return k;
      }
      for(const [k, v] of Object.entries(foodDB)) {
        if(v.name.toLowerCase().includes(q)) return k;
      }
      // 2. Tokenized search
      const tokens = q.split(/\s+/).filter(t => t.length > 2);
      let bestMatch = null;
      let highestScore = 0;
      for(const [k, v] of Object.entries(foodDB)) {
        let score = 0;
        tokens.forEach(tok => {
          if(v.name.toLowerCase().includes(tok)) score += 3;
          if(v.desc.toLowerCase().includes(tok)) score += 1;
        });
        if(score > highestScore) {
          highestScore = score;
          bestMatch = k;
        }
      }
      return highestScore > 0 ? bestMatch : null;
    }

